# Bookify.API - environment variables template
# Copy the names below into your hosting dashboard (e.g. Render) or a local, git-ignored .env file.
# Environment variables override values in appsettings. Never commit real values.

ConnectionStrings__PostgresConnection=
Jwt__Key=
Jwt__Issuer=
Jwt__Audience=
AutoMapper__LicenseKey=

Admin__Email=
Admin__Password=
Admin__FullName=
Admin__PhoneNumber=

CloudinarySettings__CloudName=
CloudinarySettings__ApiKey=
CloudinarySettings__ApiSecret=

EmailSettings__Host=
EmailSettings__Port=587
EmailSettings__Username=
EmailSettings__Password=
EmailSettings__From=

StripeSettings__PublishableKey=
StripeSettings__SecretKey=
StripeSettings__WebhookSecret=

AllowedOrigins__0=https://your-client-domain.example
AllowedHosts=*
ASPNETCORE_ENVIRONMENT=Development
